{
  "openapi": "3.0.0",
  "info": {
    "title": "Sample Enterprise Service",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://api.insecure-domain.com/v1",
      "description": "Production HTTP server (Insecure)"
    }
  ],
  "paths": {
    "/api/users": {
      "get": {
        "summary": "List all users without pagination",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create user without auth and with role in body",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": { "type": "string" },
                  "role": { "type": "string" },
                  "webhook_url": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Created" }
        }
      }
    },
    "/api/reports": {
      "get": {
        "summary": "Fetch reports using token in query",
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "callback_url",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "OK" }
        }
      }
    },
    "/api/undocumented-action": {
      "post": {
        "summary": "",
        "description": "",
        "responses": {
          "200": { "description": "OK" }
        }
      }
    }
  }
}
